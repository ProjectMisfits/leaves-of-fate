; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Misfits MQP Project"
run/main_scene="uid://18bv6betadgh"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=120
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bboukivc3dgxm"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
SceneManager="*res://src/autoload/scene_manager.gd"
EventFlags="*res://src/autoload/event_flags/event_flags.gd"
DebugMenu="*res://src/autoload/debug_menu/debug_menu.tscn"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
CameraManager="*res://src/autoload/camera_manager/camera_manager.gd"
CutsceneManager="*res://src/autoload/cutscene_manager/cutscene_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
MusicManager="*res://src/autoload/audio_managers/music_manager.tscn"
AmbianceManager="*res://src/autoload/audio_managers/ambiance_manager.tscn"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1

[dialogue_manager]

editor/advanced/custom_test_scene_path="uid://csnkgcrn5nfkl"
runtime/balloon_path="uid://du42aku0qy3o5"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"

[editor]

naming/node_name_num_separator=3
script/templates_search_path="res://src/script_templates"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[gui]

theme/custom="uid://cr6ry63vvyjhi"
theme/custom_font="uid://casj2vjnnvd5r"

[inkgd]

register_templates=true

